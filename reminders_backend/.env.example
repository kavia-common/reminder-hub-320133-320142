# Backend environment example (do not commit secrets)
# Existing CORS/URLs are set by the platform; keep in sync with deployed values.
#
# Required in preview: point to the running Postgres instance.
# The reminders_database container's db_connection.txt shows a local dev example.
#
# --- Database (required) ---
# Provide a full Postgres connection string.
# Example (local): postgresql://appuser:dbuser123@localhost:5000/myapp
DATABASE_URL=

# Optional fallback (if you prefer this name in your environment):
# POSTGRES_URL=

# --- CORS (optional) ---
# Allow requests from the frontend preview URL.
# Comma-separated. Use "*" only for development.
# ALLOWED_ORIGINS=https://<frontend-host>
# ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
# ALLOWED_HEADERS=*
# CORS_MAX_AGE=3600
